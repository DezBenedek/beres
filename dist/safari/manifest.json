{
  "manifest_version": 3,
  "name": "Béres – Egyszerű rendelés",
  "version": "1.0.1",
  "description": "Nagy gombok, napi ételfotók és átlátható kosár a Béres Alexandra ételrendeléséhez. Nem hivatalos bővítmény.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Egyszerű ételrendelés",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.beresalexandra.hu/*",
        "https://beresalexandra.hu/*"
      ],
      "js": [
        "adapter.js",
        "content.js"
      ],
      "css": [
        "page.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui.css"
      ],
      "matches": [
        "https://www.beresalexandra.hu/*",
        "https://beresalexandra.hu/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  }
}
